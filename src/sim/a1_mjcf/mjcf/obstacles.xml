<mujoco model="a1 obstacle course">
  <include file="a1.xml"/>

  <statistic center="5.5 0 0.2" extent="6"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <!-- Keep identical to empty.xml: the depth pipeline expects the same FOV. -->
    <global azimuth="-130" elevation="-20" offwidth="640" offheight="480"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <!-- Obstacle course, laid out along +x (the robot's initial heading).
       The first meter stays flat so the robot can stand up and settle.

         x 1.2 - 2.6   stepping stones  (h = 0.05)
         x 3.0 - 4.2   4 stairs         (h = 0.06 .. 0.24)
         x 4.6 - 5.8   ramp 15 deg      (h = 0 .. 0.32)
         x 6.2 - 6.9   platform         (h = 0.32)
         x 7.4         hurdle           (h = 0.10)
         x 8.0         pipe             (r = 0.06)
         x 8.5 - 10.9  gap / trench     (0.35 m wide, 0.2 m deep)
       Box geoms use half-extents, so size="hx hy hz" is half the side length. -->
  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- stepping stones: alternate left/right so a single foot lands on each -->
    <geom name="stone_0" type="box" size="0.175 0.175 0.025" pos="1.25 -0.28 0.025" rgba="0.45 0.45 0.5 1"/>
    <geom name="stone_1" type="box" size="0.175 0.175 0.025" pos="1.70  0.28 0.025" rgba="0.45 0.45 0.5 1"/>
    <geom name="stone_2" type="box" size="0.175 0.175 0.025" pos="2.15 -0.28 0.025" rgba="0.45 0.45 0.5 1"/>
    <geom name="stone_3" type="box" size="0.175 0.175 0.025" pos="2.60  0.28 0.025" rgba="0.45 0.45 0.5 1"/>

    <!-- stairs: 4 steps, each 0.3 m deep and 0.06 m taller than the previous -->
    <geom name="stair_0" type="box" size="0.15 0.6 0.03" pos="3.15 0 0.03" rgba="0.55 0.45 0.35 1"/>
    <geom name="stair_1" type="box" size="0.15 0.6 0.06" pos="3.45 0 0.06" rgba="0.55 0.45 0.35 1"/>
    <geom name="stair_2" type="box" size="0.15 0.6 0.09" pos="3.75 0 0.09" rgba="0.55 0.45 0.35 1"/>
    <geom name="stair_3" type="box" size="0.15 0.6 0.12" pos="4.05 0 0.12" rgba="0.55 0.45 0.35 1"/>

    <!-- ramp (11.3 deg, rises 0.24 m) then the platform it leads onto
         (the platform starts exactly where the ramp ends, x = 5.80) -->
    <geom name="ramp" type="box" size="0.612 0.6 0.02" pos="5.20 0 0.12" euler="0 -0.1974 0"
      rgba="0.4 0.55 0.45 1"/>
    <geom name="platform" type="box" size="0.35 0.6 0.12" pos="6.15 0 0.12" rgba="0.4 0.55 0.45 1"/>

    <!-- hurdle: 0.10 m tall bar to step over -->
    <geom name="hurdle" type="box" size="0.02 0.5 0.05" pos="7.40 0 0.05" rgba="0.7 0.4 0.4 1"/>

    <!-- pipe: laid across the path, roll over / step over it -->
    <geom name="pipe" type="cylinder" size="0.06 0.5" pos="8.00 0 0.06" euler="1.5708 0 0"
      rgba="0.6 0.6 0.3 1"/>

    <!-- gap: two raised platforms with a 0.35 m wide, 0.2 m deep trench between them -->
    <geom name="gap_in" type="box" size="0.5 0.6 0.1" pos="9.00 0 0.1" rgba="0.45 0.45 0.5 1"/>
    <geom name="gap_out" type="box" size="0.5 0.6 0.1" pos="10.35 0 0.1" rgba="0.45 0.45 0.5 1"/>

    <!-- loose rocks on both sides: bumps that disturb the feet without blocking the path -->
    <geom name="rock_0" type="box" size="0.09 0.11 0.04" pos="1.60 -0.95 0.04" euler="0 0 0.4"
      rgba="0.5 0.5 0.45 1"/>
    <geom name="rock_1" type="box" size="0.07 0.08 0.05" pos="2.40 -0.90 0.05" euler="0 0 -0.3"
      rgba="0.5 0.5 0.45 1"/>
    <geom name="rock_2" type="box" size="0.10 0.07 0.03" pos="1.90  0.92 0.03" euler="0 0 0.9"
      rgba="0.5 0.5 0.45 1"/>
    <geom name="rock_3" type="box" size="0.08 0.09 0.06" pos="2.95  0.95 0.06" euler="0 0 0.2"
      rgba="0.5 0.5 0.45 1"/>
    <geom name="rock_4" type="box" size="0.11 0.09 0.04" pos="6.90 -0.95 0.04" euler="0 0 -0.6"
      rgba="0.5 0.5 0.45 1"/>
    <geom name="rock_5" type="box" size="0.08 0.10 0.05" pos="7.90  0.90 0.05" euler="0 0 0.5"
      rgba="0.5 0.5 0.45 1"/>
  </worldbody>
</mujoco>
